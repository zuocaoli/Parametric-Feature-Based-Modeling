{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "配置本课程 clangd",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/builder.py",
                "configure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "构建本课程",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/builder.py",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "运行本课程",
            "type": "process",
            "command": "${workspaceFolder}/run.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "验证本课程",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/builder.py",
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "检查本课程格式",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/builder.py",
                "check-format"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "验证本课程代码跳转",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/check_navigation.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
